<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<Dialog
		id="detailDialog"
		title="{companyName}"
		contentWidth="68rem"
		resizable="true"
		draggable="true"
		busyIndicatorDelay="0"
		afterClose=".onDetailAfterClose">
		<content>
			<VBox class="sapUiSmallMargin">
				<!-- same process flow as the supplier sees (filled by model/processFlow.js);
				     68rem dialog width keeps ProcessFlow at zoom level Two (title + state + date) -->
				<VBox id="detailFlowContainer" />

				<MessageStrip
					text="{detail>/aiMessage}"
					type="{detail>/aiMessageType}"
					showIcon="true"
					visible="{= !!${detail>/aiMessage} }"
					class="sapUiSmallMarginTop" />

				<f:SimpleForm
					editable="false"
					layout="ColumnLayout"
					columnsM="2"
					columnsL="2"
					columnsXL="2"
					title="{i18n>sectionApplication}">
					<f:content>
						<Label text="{i18n>status}" />
						<ObjectStatus
							text="{path: 'status', formatter: '.statusText'}"
							state="{path: 'status', formatter: '.statusState'}" />
						<Label text="{i18n>companyName}" />
						<Text text="{companyName}" />
						<Label text="{i18n>contactPerson}" />
						<Text text="{contactPerson}" />
						<Label text="{i18n>email}" />
						<Text text="{email}" />
						<Label text="{i18n>phone}" />
						<Text text="{phone}" />
						<Label text="{i18n>country}" />
						<Text text="{country}" />
						<Label text="{i18n>category}" />
						<Text text="{path: 'category', formatter: '.categoryText'}" />
						<Label text="{i18n>taxNumber}" />
						<Text text="{taxNumber}" />
						<Label text="{i18n>website}" />
						<Text text="{website}" />
						<Label text="{i18n>address}" />
						<Text text="{address}" />
						<Label text="{i18n>notes}" />
						<Text text="{notes}" />
						<Label text="{i18n>submittedAt}" />
						<Text text="{submittedAt}" />
						<Label text="{i18n>certificate}" />
						<Link
							text="{= %{certificateFileName} || ${i18n>noCertificate} }"
							enabled="{= !!%{certificateFileName} }"
							href="{= '/odata/v4/supplier/Suppliers(' + %{ID} + ')/certificate' }"
							target="_blank" />
						<Label text="{i18n>decisionSource}" visible="{= !!%{decisionSource} }" />
						<Text text="{path: 'decisionSource', formatter: '.decisionSourceText'}" visible="{= !!%{decisionSource} }" />
						<Label text="{i18n>decidedBy}" visible="{= !!%{decidedBy} }" />
						<Text text="{decidedBy}" visible="{= !!%{decidedBy} }" />
						<Label text="{i18n>decidedAt}" visible="{= !!%{decidedAt} }" />
						<Text text="{decidedAt}" visible="{= !!%{decidedAt} }" />
						<Label text="{i18n>rejectionComment}" visible="{= !!%{rejectionComment} }" />
						<Text text="{rejectionComment}" visible="{= !!%{rejectionComment} }" />
					</f:content>
				</f:SimpleForm>

				<!-- decision area: only while the application is still open -->
				<VBox visible="{= %{status} === 'SUBMITTED' || %{status} === 'IN_REVIEW' }" class="sapUiSmallMarginTop">
					<Title text="{i18n>sectionDecision}" level="H3" titleStyle="H5" class="sapUiSmallMarginBottom" />
					<Label text="{i18n>rejectCommentLabel}" labelFor="rejectComment" />
					<TextArea
						id="rejectComment"
						value="{detail>/comment}"
						rows="3"
						width="100%"
						maxLength="1000"
						placeholder="{i18n>rejectCommentPlaceholder}"
						valueState="{detail>/commentState}"
						valueStateText="{i18n>commentRequired}"
						liveChange=".onCommentChange" />
					<Label text="{i18n>revisionFieldsLabel}" labelFor="revisionFields" class="sapUiSmallMarginTop" />
					<MultiComboBox id="revisionFields" selectedKeys="{detail>/revisionFields}" width="100%">
						<core:Item key="certificate" text="{i18n>certificate}" />
						<core:Item key="companyName" text="{i18n>companyName}" />
						<core:Item key="contactPerson" text="{i18n>contactPerson}" />
						<core:Item key="phone" text="{i18n>phone}" />
						<core:Item key="country" text="{i18n>country}" />
						<core:Item key="category" text="{i18n>category}" />
						<core:Item key="taxNumber" text="{i18n>taxNumber}" />
						<core:Item key="website" text="{i18n>website}" />
						<core:Item key="address" text="{i18n>address}" />
						<core:Item key="notes" text="{i18n>notes}" />
					</MultiComboBox>
					<Text text="{i18n>revisionFieldsHint}" class="sapUiTinyMarginTop" />
				</VBox>
			</VBox>
		</content>
		<buttons>
			<Button
				text="{i18n>aiButton}"
				icon="sap-icon://business-objects-experience"
				visible="{= %{status} === 'SUBMITTED' || %{status} === 'IN_REVIEW' }"
				press=".onAnalyzeWithAI" />
			<Button
				text="{i18n>approveButton}"
				type="Accept"
				icon="sap-icon://accept"
				visible="{= %{status} === 'SUBMITTED' || %{status} === 'IN_REVIEW' }"
				press=".onApprove" />
			<Button
				text="{i18n>rejectButton}"
				type="Reject"
				icon="sap-icon://decline"
				visible="{= %{status} === 'SUBMITTED' || %{status} === 'IN_REVIEW' }"
				press=".onReject" />
			<Button text="{i18n>closeButton}" press=".onCloseDetail" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>
