{
  "xsappname": "supplier-mgmt",
  "tenant-mode": "dedicated",
  "description": "Supplier Management - one scope for the approver side",
  "scopes": [
    {
      "name": "$XSAPPNAME.Approval",
      "description": "Review, approve and reject supplier applications"
    }
  ],
  "role-templates": [
    {
      "name": "Approval",
      "description": "Supplier approver",
      "scope-references": ["$XSAPPNAME.Approval"]
    }
  ],
  "role-collections": [
    {
      "name": "SupplierApprover",
      "description": "Supplier approver (Supplier Approvals app)",
      "role-template-references": ["$XSAPPNAME.Approval"]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": ["http://localhost:5000/**"]
  }
}
